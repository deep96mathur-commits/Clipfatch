# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Download and Safety Limits
MAX_DOWNLOAD_SIZE_MB=150
DOWNLOAD_TIMEOUT_SECONDS=60
TEMP_DIR=/tmp/clipfetch

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Residential proxy or Netscape cookies.txt to bypass YouTube datacenter bot detection
# YTDL_PROXY=http://user:pass@proxy-host:port
# YTDL_COOKIES_FILE=cookies.txt

# Frontend Configuration: Point to your deployed Python FastAPI/Flask API URL (e.g. https://clipfetch-api.onrender.com)
# Leave blank when running fullstack together on the same domain
VITE_API_BASE_URL=

# AI Studio injected variables (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
