# Flask Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# CORS Configuration (Set to your published frontend domain, e.g. https://clipfetch.com, or * for all)
CORS_ORIGIN=*

# Download Configuration
TEMP_DIR=/tmp/clipfetch_flask
DOWNLOAD_TIMEOUT_SECONDS=120
TICKET_EXPIRATION_SECONDS=300
